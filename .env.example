# GEMINI_API_KEY: Required for Gemini AI API calls when not using Vertex AI ADC.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_PROJECT: Google Cloud Project ID for Vertex AI billing and ADC authentication.
# Enables routing Gemini API requests through your linked Google Cloud project credits.
GOOGLE_CLOUD_PROJECT=""

# GOOGLE_CLOUD_LOCATION: Google Cloud region for Vertex AI endpoints (e.g. us-central1, asia-southeast1).
GOOGLE_CLOUD_LOCATION="us-central1"

# GOOGLE_GENAI_USE_VERTEXAI: Enable Vertex AI mode with Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

